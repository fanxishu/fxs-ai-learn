# ============================================
# 鱼皮 AI 闯关 - 后端环境变量示例文件
# 使用方式：复制此文件为 .env，然后填入你的真实配置
# 注意：.env 文件包含 API Key 等敏感信息，严禁提交到 Git！
# ============================================

# ---- DeepSeek AI 配置 ----
# DeepSeek API Key（在 https://platform.deepseek.com/ 申请获取）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DeepSeek 兼容接口地址
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 默认模型
DEEPSEEK_MODEL=deepseek-chat
# 请求超时（秒）
DEEPSEEK_TIMEOUT=30
# 题目生成温度（0-1，越低越稳定）
DEEPSEEK_TEMPERATURE_QUIZ=0.4
# 报告生成温度
DEEPSEEK_TEMPERATURE_REPORT=0.5
# 最大重试次数
DEEPSEEK_MAX_RETRIES=2

# ---- AI Mock 开关 ----
# true: 读本地 fixture JSON（无需 API Key，全链路可跑通，推荐首次和 UI 调试用）
# false: 真实调用 DeepSeek（需要上方 DEEPSEEK_API_KEY 有效）
USE_MOCK_LLM=false

# ---- 业务配置 ----
# 用户输入字数限制
USER_INPUT_MIN_LEN=5
USER_INPUT_MAX_LEN=500
# 生成题目数（3-5）
DEFAULT_QUESTION_COUNT=5
MIN_QUESTION_COUNT=3
MAX_QUESTION_COUNT=5

# ---- 微信小程序配置 ----
# 小程序 AppID（在微信公众平台 -> 开发管理 -> 开发设置 中获取）
WECHAT_APPID=your_wechat_appid_here
# 小程序 AppSecret（在微信公众平台 -> 开发管理 -> 开发设置 中获取，切勿泄露！）
WECHAT_APPSECRET=your_wechat_appsecret_here
