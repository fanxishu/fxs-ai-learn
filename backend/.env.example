# ============================================
# 智能 AI 闯关 - 后端环境变量示例文件
# 使用方式：复制此文件为 .env，然后填入你的真实配置
# 注意：.env 文件包含 API Key 等敏感信息，严禁提交到 Git！
# ============================================

# ---- DeepSeek AI 配置 ----
# DeepSeek API Key（在 https://platform.deepseek.com/ 申请获取）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DeepSeek 兼容接口地址
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 默认模型
DEEPSEEK_MODEL=deepseek-chat
# 请求超时（秒）
DEEPSEEK_TIMEOUT=30
# 题目生成温度（0-1，越低越稳定）
DEEPSEEK_TEMPERATURE_QUIZ=0.4
# 报告生成温度
DEEPSEEK_TEMPERATURE_REPORT=0.5
# 最大重试次数
DEEPSEEK_MAX_RETRIES=2

# ---- AI Mock 开关 ----
# true: 读本地 fixture JSON（无需 API Key，全链路可跑通，推荐首次和 UI 调试用）
# false: 真实调用 DeepSeek（需要上方 DEEPSEEK_API_KEY 有效）
USE_MOCK_LLM=false

# ---- 业务配置 ----
# 用户输入字数限制
USER_INPUT_MIN_LEN=5
USER_INPUT_MAX_LEN=500
# 生成题目数（3-5）
DEFAULT_QUESTION_COUNT=5
MIN_QUESTION_COUNT=3
MAX_QUESTION_COUNT=5

# ---- 微信小程序配置 ----
# 小程序 AppID（在微信公众平台 -> 开发管理 -> 开发设置 中获取）
WECHAT_APPID=your_wechat_appid_here
# 小程序 AppSecret（在微信公众平台 -> 开发管理 -> 开发设置 中获取，切勿泄露！）
WECHAT_APPSECRET=your_wechat_appsecret_here

# ---- MySQL 数据库配置 ----
# 数据库驱动（pymysql / mysqlconnector，推荐 pymysql，需 pip install pymysql）
DB_DRIVER=pymysql
# 数据库主机地址（本地: 127.0.0.1，线上: 内网 IP 或 RDS 域名）
DB_HOST=127.0.0.1
# 数据库端口（MySQL 默认 3306）
DB_PORT=3306
# 数据库用户名
DB_USER=your_db_username_here
# 数据库密码
DB_PASSWORD=your_db_password_here
# 数据库名（请先手动创建：CREATE DATABASE fxs_ai_learn DEFAULT CHARACTER SET utf8mb4;）
DB_NAME=fxs_ai_learn
# 字符集（推荐 utf8mb4 支持 emoji 和中文 4 字节）
DB_CHARSET=utf8mb4
# SQLAlchemy 连接串（通常无需手动指定，由 config.py 自动根据上方字段合成；如需单独指定可取消注释
# DATABASE_URL=mysql+pymysql://your_db_user:your_db_pass@127.0.0.1:3306/fxs_ai_learn?charset=utf8mb4

# ---- JWT 鉴权配置 ----
# JWT 签名密钥（生产环境必须更换，建议长度 >= 32 字节，可用 python -c "import secrets;print(secrets.token_urlsafe(32))" 生成）
JWT_SECRET_KEY=your_jwt_secret_here
# 签名算法（仅允许 HS256，防 alg:none 攻击，不要修改）
JWT_ALGORITHM=HS256
# Token 过期天数（默认 7 天）
JWT_EXPIRE_DAYS=7

# ---- 微信登录 Mock 开关 ----
# true: 强制使用 mock 模式（把 code 原样当作 openid），适合本地 pytest 单测和没有真实 AppID/Secret 的环境
# false: 严格调用微信 jscode2session 真实接口，失败时自动 fallback mock（保证开发稳定性）
USE_MOCK_WX_LOGIN=false

# Optional persistent avatar directory (default: backend/uploads/avatars).
# Keep this directory on persistent storage when deploying the backend.
# AVATAR_UPLOAD_DIR=/data/fxs-ai-learn/avatars
